<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Properties -->
    <xacro:property name="base_length" value="0.30"/>
    <xacro:property name="base_width"  value="0.20"/>
    <xacro:property name="base_height" value="0.245"/>
    <xacro:property name="wheel_radius" value="0.112"/>
    <xacro:property name="wheel_length" value="0.045"/>
    <xacro:property name="lidar_length" value="0.060"/>
    <xacro:property name="lidar_width" value="0.047"/>
    <xacro:property name="lidar_heigth" value="0.096"/>

    <!-- Footprint -->
    <link name="base_footprint"/>

    <!-- Base Link -->
    <link name="base_link">
        <visual>
            
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0 0 ${wheel_radius+(base_height/2.0)}" rpy="0 0 0"/>
            <material name="green "/>
        </visual>
        <xacro:box_inertia m="5.0" x="${base_length}" y="${base_width}" z="${base_height}"
                           xyz="0 0 0" rpy="0 0 0"/>

        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0 0 ${wheel_radius+(base_height/2.0)}" rpy="0 0 0"/>
        </collision>
    </link>

    <link name="lidar_link">
         <visual>
              <geometry>
                   <box size="${lidar_length} ${lidar_width} ${lidar_heigth}"/>
              </geometry>
              <origin xyz="0 0 0" rpy="0 0 0"/>
              <material name="color2"/>
         </visual>
         <xacro:box_inertia m="5.0" x="${lidar_length}" y="${lidar_width}" z="${lidar_heigth}"
                            xyz="0 0 0" rpy="0 0 0"/>

        <collision>
            <geometry>
                   <box size="${lidar_length} ${lidar_width} ${lidar_heigth}"/>
              </geometry>
              <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
    </link>

    <link name="camera_link">
        <visual>
            <geometry>
                <box size="0.05 0.05 0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="violet"/>
        </visual>
        <xacro:box_inertia m="1.0" x="0.05" y="0.05" z="0.05"
                           xyz="0 0 0"   rpy="0 0 0"/>

        <collision>
            <geometry>
                <box size="0.05 0.05 0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
    </link>

   
    <link name="right_back_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
            <material name="violet" />
        </visual>
        <xacro:cyl_inertia m="1.0" r="${wheel_radius}" h="${wheel_length}"
                           xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        <collision>
           <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        </collision>
    </link>

    <link name="left_back_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
            <material name="violet" />
        </visual>
        <xacro:cyl_inertia m="1.0" r="${wheel_radius}" h="${wheel_length}"
                           xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        <collision>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        </collision>
    </link>

    <link name="left_front_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
            <material name="violet" />
        </visual>
        <xacro:cyl_inertia m="1.0" r="${wheel_radius}" h="${wheel_length}"
                           xyz="0 0 0" rpy="${pi/2.0} 0 0"/>

        <collision>
             <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        </collision>
    </link>

    <link name="right_front_wheel_link">
        <visual>
            <geometry>
               <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
            </geometry>
    <!-- Visual is centered in its own link frame -->
            <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
            <material name="violet" />
        </visual>
        <xacro:cyl_inertia m="1.0" r="${wheel_radius}" h="${wheel_length}"
                           xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        <collision>
            <geometry>
               <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        </collision>
        
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="${(base_length/2.0)-0.01175} 0 0.224" rpy="0 0 0"/>
    </joint>

    <joint name="camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="camera_link"/>
        <origin xyz="${(base_length/2.0)-0.01175} 0 ${base_height+0.112+0.025}" rpy="0 0 0"/>
    </joint>

   <joint name="l_b_wheel_base_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_back_wheel_link"/>
        <origin xyz="-${(base_length/2.0)-0.01175} -${(base_width+wheel_length)/2.0} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>
    <joint name="r_b_wheel_base_joint" type="continuous">
         <parent link="base_link"/>
         <child link="right_back_wheel_link"/>
         <origin xyz="-${(base_length/2.0)-0.01175} +${(base_width+wheel_length)/2.0} 0" rpy="0 0 0"/>
         <axis xyz="0 1 0"/>
    </joint>
    <!-- front left wheel -->
    <joint name="l_f_wheel_base_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_front_wheel_link"/>
        <origin xyz="${(base_length/2.0)-0.01175} -${(base_width+wheel_length)/2.0} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- front right wheel -->
    <joint name="r_f_wheel_base_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_front_wheel_link"/>
        <origin xyz="${(base_length/2.0)-0.01175} ${(base_width+wheel_length)/2.0} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>
</robot>