<?xml version ="1.0"?>
<robot  xmlns:xacro="https://www.ros.org/wiki/xacro">
    <material name ="green ">
        <color rgba="1 0 0 1"/>
    </material>

    <material name ="color2">
        <color rgba="1 1 0 1"/>
    </material>

    <material name="violet">
          <color rgba="0 0 1 1"/>
    </material>

    <xacro:macro name="box_inertia" params="m x y z xyz rpy">
       <inertial>
            <mass value="${m}" />
            <origin xyz="${xyz}" rpy="${rpy}"/>
            <inertia ixx="${(m/12.0)*(y*y+z*z)}" ixy="0" ixz="0" iyy="${(m/12.0)*(x*x+z*z)}" iyz="0" izz="${(m/12.0)*(y*y+x*x)}" />
       </inertial>
   </xacro:macro>

   <xacro:macro name="cyl_inertia" params="m r h xyz rpy">
        <inertial>
             <mass value="${m}"/>
             <origin xyz="${xyz}" rpy="${rpy}"/>
             <inertia ixx="${(m/12.0)*(3*r*r+h*h)}" ixy="0" ixz="0" iyy="${(m/12.0)*(3*r*r+h*h)}" iyz="0" izz="${(m/2.0)*r*r}"/>
         </inertial>
   </xacro:macro>

</robot>